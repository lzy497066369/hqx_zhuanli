# 前端独立构建，不加载服务端 Vite 中间件或模型/数据库配置。
FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.app.json vite.frontend.config.ts index.html ./
COPY src ./src
COPY public ./public
RUN npm exec -- tsc -p tsconfig.app.json && npm exec -- vite build --config vite.frontend.config.ts

FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
