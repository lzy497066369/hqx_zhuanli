# Server-side only. Copy to .env.local and set mode 0600. Never use a VITE_ prefix.
AI_BASE_URL=https://api.psydo.top/v1
AI_MODEL=gpt-6.1-sol
AI_RESEARCH_MODEL=gpt-6.1-sol
# Tried when the primary model fails.
AI_FALLBACK_MODEL=gpt-6-sol
AI_SECOND_FALLBACK_MODEL=gpt-6-astra
AI_API_KEY=
# Research uses the research model, then both fallbacks; all must support the required endpoint.

# Research only: native Responses web search.
AI_RESEARCH_PROTOCOL=responses

# Image generation has its own server-only credentials (OpenAI-compatible images/generations).
AI_IMAGE_BASE_URL=https://l0veyou.com/v1
# Use an image model explicitly enabled for the key group; /models may list text-only models.
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_API_KEY=
# Optional, only when the provider supports it, e.g. 1536x1024.
AI_IMAGE_SIZE=
# Optional stable signing secret; defaults to the text API key. Rotation invalidates prior workflow receipts.
AI_WORKFLOW_SIGNING_KEY=

# Vision model that reads the four colour previews and writes the FreeCAD script.
# Leave empty to reuse AI_MODEL (it must accept image_url input).
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
# FreeCAD command-line binary (freecadcmd). Auto-detected from PATH and common install folders when empty.
# Windows: winget install FreeCAD.FreeCAD -> %LOCALAPPDATA%\Programs\FreeCAD 1.1\bin\freecadcmd.exe
FREECAD_CMD=
# Per-model build timeout in milliseconds (default 300000).
FREECAD_TIMEOUT_MS=

# MySQL storage (server-side only). Docker uses .env for the same credentials.
STORAGE_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=zhichuang
MYSQL_USER=zhichuang
MYSQL_PASSWORD=
# Legacy / isolated-test fallback only. Logged-in users use their owned workspaces.
MYSQL_WORKSPACE_ID=default
# Docker MySQL initialization only; keep in .env, never in frontend code.
MYSQL_ROOT_PASSWORD=

# Application login is enabled by default. Disable only for isolated legacy tests.
AUTH_REQUIRED=true
